<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace>DuckovCustomModel</RootNamespace>
		<AssemblyName>DuckovCustomModel.GameModules</AssemblyName>
		<PackageName>DuckovCustomModel</PackageName>
		<ModelRuntimeBinaryRoot Condition="'$(ModelRuntimeBinaryRoot)' == ''">$(MSBuildProjectDirectory)\..\lib</ModelRuntimeBinaryRoot>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<PackageMod Condition="'$(PackageMod)' == '' AND '$(Configuration)' == 'Release' AND '$(CI)' != 'true' AND '$(GITHUB_ACTIONS)' != 'true'">true</PackageMod>
		<PackageMod Condition="'$(PackageMod)' == ''">false</PackageMod>
		<PwshExecutable Condition="'$(PwshExecutable)' == ''">pwsh</PwshExecutable>
	</PropertyGroup>

	<PropertyGroup>
		<DuckovPath Condition="'$(DuckovPath)' == ''">E:\SteamLibrary\steamapps\common\Escape from Duckov</DuckovPath>
	</PropertyGroup>

	<PropertyGroup>
		<UseGameLibsFromNuGet Condition="'$(UseGameLibsFromNuGet)' == '' AND ('$(CI)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true')">true</UseGameLibsFromNuGet>
		<UseGameLibsFromNuGet Condition="'$(UseGameLibsFromNuGet)' == ''">false</UseGameLibsFromNuGet>
	</PropertyGroup>

	<!-- CI 环境使用 NuGet 包 -->
	<ItemGroup Condition="'$(UseGameLibsFromNuGet)' == 'true'">
		<PackageReference Include="DuckovGameLibs" Version="2.0.26-Steam"/>
	</ItemGroup>

	<!-- 本地开发使用游戏目录 -->
	<ItemGroup Condition="'$(UseGameLibsFromNuGet)' == 'false'">
		<Reference Include="$(DuckovManagedPath)\TeamSoda.*.dll">
			<Private>False</Private>
		</Reference>
		<Reference Include="$(DuckovManagedPath)\ItemStatsSystem.dll">
			<Private>False</Private>
		</Reference>
		<Reference Include="$(DuckovManagedPath)\SodaLocalization.dll">
			<Private>False</Private>
		</Reference>
		<Reference Include="$(DuckovManagedPath)\Unity*.dll">
			<Private>False</Private>
		</Reference>
		<Reference Include="$(DuckovManagedPath)\FMODUnity.dll">
			<Private>False</Private>
		</Reference>
		<Reference Include="$(DuckovManagedPath)\UniTask.dll">
			<Private>False</Private>
		</Reference>
		<Reference Include="$(DuckovManagedPath)\Newtonsoft.Json.dll">
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Publicize Include="TeamSoda.Duckov.Core" IncludeCompilerGeneratedMembers="false" IncludeVirtualMembers="false"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Krafs.Publicizer" Version="2.3.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Lib.Harmony" Version="2.4.1">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<None Update="info.ini">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="preview.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Resources\ysm-rendering.bundle">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Localizations\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>Localizations\%(Filename)%(Extension)</TargetPath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="ModelRuntime"><HintPath>$(ModelRuntimeBinaryRoot)\ModelRuntime.dll</HintPath></Reference>
		<Reference Include="ModelRuntime.Adapters"><HintPath>$(ModelRuntimeBinaryRoot)\ModelRuntime.Adapters.dll</HintPath></Reference>
		<Reference Include="ModelRuntime.Media"><HintPath>$(ModelRuntimeBinaryRoot)\ModelRuntime.Media.dll</HintPath></Reference>
		<Reference Include="ModelRuntime.Ysm"><HintPath>$(ModelRuntimeBinaryRoot)\ModelRuntime.Ysm.dll</HintPath></Reference>
		<Reference Include="StbImageSharp"><HintPath>$(ModelRuntimeBinaryRoot)\StbImageSharp.dll</HintPath></Reference>
		<Reference Include="ZstdSharp"><HintPath>$(ModelRuntimeBinaryRoot)\ZstdSharp.dll</HintPath></Reference>
		<Reference Include="System.Runtime.CompilerServices.Unsafe"><HintPath>$(ModelRuntimeBinaryRoot)\System.Runtime.CompilerServices.Unsafe.dll</HintPath></Reference>
		<ProjectReference Include="..\DuckovCustomModel.Core\DuckovCustomModel.Core.csproj"/>
		<ProjectReference Include="..\DuckovCustomModel.ModLoader\DuckovCustomModel.ModLoader.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<Target Name="ValidateModelRuntimeBinaries" BeforeTargets="PrepareForBuild">
		<Error Condition="!Exists('$(ModelRuntimeBinaryRoot)\ModelRuntime.dll') Or !Exists('$(ModelRuntimeBinaryRoot)\ModelRuntime.Adapters.dll') Or !Exists('$(ModelRuntimeBinaryRoot)\ModelRuntime.Media.dll') Or !Exists('$(ModelRuntimeBinaryRoot)\ModelRuntime.Ysm.dll')"
			   Text="The four precompiled ModelRuntime DLLs are required in ModelRuntimeBinaryRoot."/>
	</Target>

	<Target Name="CopyModLoaderOutput" AfterTargets="Build">
		<PropertyGroup>
			<ModLoaderProjectDir>$([System.IO.Path]::GetFullPath($(MSBuildProjectDirectory)\..\DuckovCustomModel.ModLoader))</ModLoaderProjectDir>
			<ModLoaderOutputPath>$([System.IO.Path]::Combine($(ModLoaderProjectDir), 'bin', '$(Configuration)', 'netstandard2.1'))</ModLoaderOutputPath>
		</PropertyGroup>

		<Message Text="复制 ModLoader 编译结果到输出目录..." Importance="normal"/>
		<Message Text="ModLoader 输出路径: $(ModLoaderOutputPath)" Importance="normal"/>
		<Message Text="目标输出路径: $(OutputPath)" Importance="normal"/>

		<ItemGroup Condition="Exists('$(ModLoaderOutputPath)')">
			<ModLoaderFiles Include="$(ModLoaderOutputPath)\*.dll;$(ModLoaderOutputPath)\*.pdb"/>
		</ItemGroup>

		<Copy SourceFiles="@(ModLoaderFiles)"
			  DestinationFolder="$(OutputPath)"
			  SkipUnchangedFiles="false"
			  Condition="'@(ModLoaderFiles)' != ''">
			<Output TaskParameter="CopiedFiles" ItemName="CopiedModLoaderFiles"/>
		</Copy>

		<Message Text="已复制 ModLoader 文件: @(CopiedModLoaderFiles)" Importance="normal" Condition="'@(CopiedModLoaderFiles)' != ''"/>
		<Warning Text="未找到 ModLoader 输出文件。请确保 ModLoader 项目已成功构建。" Condition="!Exists('$(ModLoaderOutputPath)')"/>
	</Target>

	<!-- Packaging is opt-in and only writes beneath this project's bin directory. -->
	<Target Name="PackageRelease" AfterTargets="CopyModLoaderOutput" Condition="'$(PackageMod)' == 'true'">
		<Exec Command="&quot;$(PwshExecutable)&quot; -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\scripts\Package-Mod.ps1&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.1&quot;"/>
	</Target>

</Project>

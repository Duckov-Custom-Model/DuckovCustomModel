<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<PropertyGroup>
		<DuckovPath Condition="'$(DuckovPath)' == ''">E:\SteamLibrary\steamapps\common\Escape from Duckov</DuckovPath>
	</PropertyGroup>

	<PropertyGroup>
		<UseGameLibsFromNuGet Condition="'$(UseGameLibsFromNuGet)' == '' AND ('$(CI)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true')">true</UseGameLibsFromNuGet>
		<UseGameLibsFromNuGet Condition="'$(UseGameLibsFromNuGet)' == ''">false</UseGameLibsFromNuGet>
	</PropertyGroup>

	<!-- CI 环境使用 NuGet 包 -->
	<ItemGroup Condition="'$(UseGameLibsFromNuGet)' == 'true'">
		<PackageReference Include="DuckovGameLibs" Version="2.0.26-Steam"/>
	</ItemGroup>

	<!-- 本地开发使用游戏目录 -->
	<ItemGroup Condition="'$(UseGameLibsFromNuGet)' == 'false'">
		<Reference Include="$(DuckovManagedPath)\TeamSoda.*.dll">
			<Private>False</Private>
		</Reference>
		<Reference Include="$(DuckovManagedPath)\Unity*.dll">
			<Private>False</Private>
		</Reference>
		<Reference Include="$(DuckovManagedPath)\Newtonsoft.Json.dll">
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Update="info.ini">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
